# EditorConfig helps maintain consistent coding styles across editors/IDEs.
# https://editorconfig.org
#
# Conventions derived from the existing codebase:
# - 2-space indentation across TS/TSX/JSON/CSS/config files
# - UTF-8, LF line endings, trailing newline on every file
# - Trailing whitespace trimmed (except Markdown, which uses it for hard breaks)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript / JavaScript (app code, config files: next.config.ts, tailwind, eslint.config.mjs)
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON / JSONC (package.json, tsconfig.json, components.json)
[*.{json,jsonc}]
indent_size = 2

# Styles
[*.{css,scss}]
indent_size = 2

# Markdown docs (guidelines.md, AGENTS.md, README.md)
# Preserve trailing spaces: they create hard line breaks in Markdown.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# YAML (CI configs, if added later)
[*.{yml,yaml}]
indent_size = 2

# Makefiles require tab indentation
[Makefile]
indent_style = tab